# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatbotDB?retryWrites=true&w=majority

# Groq Cloud API Key (Get free from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Default LLM Model (Defaults to openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Port for the Express backend service (Render sets this automatically)
PORT=5000
