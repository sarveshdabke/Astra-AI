# ==============================================================================
# Astra AI — Server Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the server/ directory:
#    cp .env.example .env
# 2. Populate the required values below before launching Node.js.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Configuration
# ------------------------------------------------------------------------------
# Port on which the Express REST API and Socket.io server will listen.
# Render, Railway, and Heroku will automatically inject PORT in production.
PORT=5000

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (MongoDB Atlas or Local MongoDB instance).
#
# Atlas Example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
#
# Local MongoDB Example:
# MONGO_URI=mongodb://127.0.0.1:27017/astraDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/astraDB?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Groq Cloud AI Inference Engine
# ------------------------------------------------------------------------------
# Groq provides ultra-high-speed LLM inference (LPU technology).
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Selected LLM Model:
# Options:
#  - openai/gpt-oss-120b      (Fast, high precision coding & reasoning)
#  - llama-3.3-70b-versatile  (Meta Llama 3.3 70B - outstanding general performance)
#  - qwen/qwen3.8-27b         (Multilingual, strong code synthesis)
#  - llama-3.1-8b-instant     (Ultra-fast lightweight responses)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# Google Cloud Console credentials used for verifying client ID tokens.
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
