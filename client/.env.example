# ==============================================================================
# Astra AI — Client Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the client/ directory:
#    cp .env.example .env
# 2. Fill in the required environment variables below before starting Vite.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API & WebSocket Endpoint (No trailing slash)
# ------------------------------------------------------------------------------
# URL of your running Express & Socket.io server.
# For Local Development:
VITE_API_URL=http://localhost:5000

# For Production Deployment (e.g. Render, Railway, AWS, DigitalOcean):
# VITE_API_URL=https://your-astra-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Client ID (Web Application)
# ------------------------------------------------------------------------------
# Required to enable Google Authentication and Identity Services on the login screen.
#
# Steps to obtain your Google Client ID:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create or select an existing project.
# 3. Navigate to "Credentials" -> "Create Credentials" -> "OAuth client ID".
# 4. Select Application Type: "Web application".
# 5. Add Authorized JavaScript origins:
#    - http://localhost:5173 (local Vite development)
#    - http://localhost:3000 (alternative local port)
#    - https://your-production-domain.vercel.app (production frontend URL)
# 6. Copy the generated Web Client ID and paste below:
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
